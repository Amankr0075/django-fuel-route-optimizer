          ],
          "body": "{\n    \"error\": {\n        \"code\": \"INVALID_LOCATION\",\n        \"message\": \"Unable to resolve the start location: No results found for location: 'Xyzzy Land 99999'.\"\n    }\n}"
        }
      ]
