# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Routing API
# OSRM is used as the routing backend (no API key required for public demo server)
# For production, self-host OSRM or use a paid service
OSRM_BASE_URL=http://router.project-osrm.org

# Nominatim Geocoding (no API key required - free OpenStreetMap service)
# For production, self-host Nominatim or use a paid geocoding provider
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# IMPORTANT: Set a unique User-Agent to comply with Nominatim usage policy
NOMINATIM_USER_AGENT=FuelRouteAPI/1.0 (your-email@example.com)

# Database (SQLite is default; for PostgreSQL uncomment and configure below)
# DATABASE_URL=postgresql://user:password@localhost:5432/fuelroute

# Cache backend (LocMemCache by default; configure Redis for production)
# CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# CACHE_LOCATION=redis://127.0.0.1:6379/1

# Vehicle defaults (do not change for assessment)
MAX_RANGE_MILES=500
FUEL_EFFICIENCY_MPG=10
